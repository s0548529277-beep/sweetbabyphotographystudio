   "custom_css": "selector {\r\n  position: relative;\r\n}\r\n\r\nselector .lmn-slider-dots {\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 30px;\r\n  transform: translateY(-50%);\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 14px;\r\n  z-index: 10;\r\n}\r\n\r\nselector .lmn-slider-dots .dot {\r\n  width: 14px;\r\n  height: 14px;\r\n  border-radius: 50%;\r\n  background-color: #FBF7F3;\r\n  opacity: 0.45;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\nselector .lmn-slider-dots .dot.active {\r\n  width: 18px;\r\n  height: 18px;\r\n  opacity: 1;\r\n}"
  },
  "elements": [
   {
    "id": "0813919",
    "elType": "widget",
    "settings": {
     "html": "<style>\r\n  .lmn-slider-dots {\r\n    position: absolute;\r\n    top: 50%;\r\n    left: 30px;\r\n    transform: translateY(-50%);\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 14px;\r\n    z-index: 10;\r\n  }\r\n\r\n  .lmn-slider-dots .dot {\r\n    width: 14px;\r\n    height: 14px;\r\n    border-radius: 50%;\r\n    background-color: #FBF7F3;\r\n    opacity: 0.45;\r\n    transition: all 0.3s ease;\r\n  }\r\n\r\n  .lmn-slider-dots .dot.active {\r\n    width: 18px;\r\n    height: 18px;\r\n    opacity: 1;\r\n  }\r\n</style>\r\n\r\n<div class=\"lmn-slider-dots\">\r\n  <span class=\"dot active\"></span>\r\n  <span class=\"dot\"></span>\r\n  <span class=\"dot\"></span>\r\n  <span class=\"dot\"></span>\r\n  <span class=\"dot\"></span>\r\n</div>\r\n\r\n<script>\r\n  /* מעבר בין נקודות כל 3 שניות - Code by LEMON SHLIF */\r\n  jQuery(document).ready(function($){\r\n    let dots = $('.lmn-slider-dots .dot');\r\n    let index = 0;\r\n\r\n    setInterval(function(){\r\n      dots.removeClass('active');\r\n      index = (index + 1) % dots.length;\r\n      dots.eq(index).addClass('active');\r\n    }, 2200);\r\n  });\r\n</script>\r\n"
    },
    "elements": [],
    "widgetType": "html"
   }
  ],
  "isInner": false
